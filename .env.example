# Free Supabase project (https://supabase.com → New project → free plan)
# Copy this file to .env.local and fill in the values from:
# Project Settings → API Keys
#
# Use either:
# - Publishable key (sb_publishable_...), or
# - Legacy anon public key (long eyJ... key under "View legacy API keys")
# Never put the secret key in this file.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
